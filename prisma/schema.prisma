generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model carrito {
  id             Int            @id @default(autoincrement())
  usuario_id     Int?
  estado         String?        @default("activo") @db.VarChar(30)
  creado_en      DateTime?      @default(now()) @db.Timestamptz(6)
  actualizado_en DateTime?      @default(now()) @db.Timestamptz(6)
  usuario        usuario?       @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  item_carrito   item_carrito[]

  @@index([usuario_id])
  @@index([estado])
}

model categoria {
  id            Int        @id @default(autoincrement())
  nombre        String     @db.VarChar(100)
  identificador String     @unique @db.VarChar(100)
  descripcion   String?
  producto      producto[]
}

model cupon {
  id               Int       @id @default(autoincrement())
  codigo           String    @unique @db.VarChar(50)
  tipo_descuento   String    @db.VarChar(20)
  valor_descuento  Decimal   @db.Decimal(12, 2)
  monto_minimo     Decimal?  @db.Decimal(12, 2)
  descuento_maximo Decimal?  @db.Decimal(12, 2)
  usos_maximos     Int?      @default(1)
  usos_actuales    Int       @default(0)
  fecha_inicio     DateTime? @db.Timestamptz(6)
  fecha_fin        DateTime? @db.Timestamptz(6)
  activo           Boolean   @default(true)
  creado_en        DateTime  @default(now()) @db.Timestamptz(6)
  pedido           pedido[]

  @@index([codigo])
  @@index([activo])
  @@index([fecha_fin])
}

model item_carrito {
  id              Int                @id @default(autoincrement())
  carrito_id      Int?
  producto_id     Int?
  cantidad        Int                @default(1)
  precio_unitario Decimal            @db.Decimal(12, 2)
  variacion_id    Int
  variacion       variacion_producto @relation(fields: [variacion_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_item_carrito_variacion")
  carrito         carrito?           @relation(fields: [carrito_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  producto        producto?          @relation(fields: [producto_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([carrito_id])
  @@index([producto_id])
  @@index([variacion_id])
}

model item_pedido {
  id              Int                @id @default(autoincrement())
  pedido_id       Int?
  producto_id     Int?
  cantidad        Int
  precio_unitario Decimal            @db.Decimal(12, 2)
  variacion_id    Int
  variacion       variacion_producto @relation(fields: [variacion_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_item_pedido_variacion")
  pedido          pedido?            @relation(fields: [pedido_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  producto        producto?          @relation(fields: [producto_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([pedido_id])
  @@index([producto_id])
  @@index([variacion_id])
}

model pago_simulado {
  id          Int       @id @default(autoincrement())
  pedido_id   Int?
  metodo      String?   @db.VarChar(50)
  estado_pago String?   @db.VarChar(30)
  referencia  String?   @db.VarChar(200)
  creado_en   DateTime? @default(now()) @db.Timestamptz(6)
  pedido      pedido?   @relation(fields: [pedido_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model pedido {
  id                      Int             @id @default(autoincrement())
  usuario_id              Int?
  total                   Decimal         @db.Decimal(12, 2)
  estado                  String?         @default("pendiente") @db.VarChar(30)
  nombre_receptor         String?         @db.VarChar(150)
  direccion_envio         String?         @db.VarChar(255)
  ciudad                  String?         @db.VarChar(100)
  region                  String?         @db.VarChar(100)
  pais                    String?         @db.VarChar(100)
  telefono_contacto       String?         @db.VarChar(50)
  codigo_tracking         String?         @db.VarChar(100)
  agencia_envio           String?         @db.VarChar(100)
  tiempo_estimado_entrega String?         @db.VarChar(100)
  cupon_id                Int?
  creado_en               DateTime?       @default(now()) @db.Timestamptz(6)
  metodo_pago             String?         @db.VarChar(50)
  notas                   String?
  voucher_url             String?         @db.VarChar(500)
  item_pedido             item_pedido[]
  pago_simulado           pago_simulado[]
  cupon                   cupon?          @relation(fields: [cupon_id], references: [id], onUpdate: NoAction)
  usuario                 usuario?        @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([usuario_id])
  @@index([estado])
  @@index([creado_en])
  @@index([cupon_id])
}

model producto {
  id           Int                  @id @default(autoincrement())
  nombre        String               @db.VarChar(200)
  descripcion   String?
  precio        Decimal              @default(0) @db.Decimal(12, 2)
  precio_oferta Decimal?             @db.Decimal(12, 2)
  imagenes      Json?
  categoria_id  Int?
  temporada_id  Int?
  slug          String?              @unique @db.VarChar(200)
  creado_en     DateTime?            @default(now()) @db.Timestamptz(6)
  genero        String?              @default("ambos") @db.VarChar(20)
  activo        Boolean              @default(true)
  recomendado   Boolean              @default(false)
  item_carrito item_carrito[]
  item_pedido  item_pedido[]
  categoria    categoria?           @relation(fields: [categoria_id], references: [id], onUpdate: NoAction)
  temporada    temporada?           @relation(fields: [temporada_id], references: [id], onUpdate: NoAction)
  variaciones  variacion_producto[]
  wishlist     wishlist[]

  @@index([categoria_id])
  @@index([temporada_id])
  @@index([genero])
  @@index([activo])
  @@index([creado_en])
  @@index([recomendado])
}

model variacion_producto {
  id           Int            @id @default(autoincrement())
  producto_id  Int
  talla        String?        @db.VarChar(20)
  color        String?        @db.VarChar(50)
  stock        Int?           @default(0)
  sku          String?        @db.VarChar(100)
  codigo_color String?        @db.VarChar(7)
  imagen_url   String?        @db.VarChar(500)
  item_carrito item_carrito[]
  item_pedido  item_pedido[]
  producto     producto       @relation(fields: [producto_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([producto_id])
  @@index([sku])
}

model temporada {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique @db.VarChar(150)
  descripcion String?
  activo      Boolean?   @default(true)
  inicio      DateTime?  @db.Date
  fin         DateTime?  @db.Date
  producto    producto[]
}

model usuario {
  id                        Int                        @id @default(autoincrement())
  nombre                    String                     @db.VarChar(150)
  email                     String                     @unique @db.VarChar(200)
  contrasena                String                     @db.VarChar(255)
  dni                       String?                    @unique @db.VarChar(20)
  direccion                 String?                    @db.VarChar(255)
  email_verificado          Boolean                    @default(false)
  rol                       String                     @default("cliente") @db.VarChar(20)
  telefono                  String?                    @db.VarChar(50)
  creado_en                 DateTime                   @default(now()) @db.Timestamptz(6)
  tiene_membresia           Boolean                    @default(false)
  fecha_membresia           DateTime?                  @db.Timestamptz(6)
  apellido                  String?                    @db.VarChar(150)
  codigo_verificacion       String?                    @db.VarChar(10)
  codigo_verificacion_exp   DateTime?                  @db.Timestamptz(6)
  carrito                   carrito[]
  email_verification_tokens email_verification_token[]
  password_reset_tokens     password_reset_token[]
  pedido                    pedido[]
  refresh_tokens            refresh_token[]
  solicitudes_membresia     solicitud_membresia[]
  wishlist                  wishlist[]

  @@index([email])
  @@index([dni])
  @@index([rol])
  @@index([tiene_membresia])
}

model solicitud_membresia {
  id                  Int       @id @default(autoincrement())
  usuario_id          Int
  email_solicitante   String    @db.VarChar(200)
  estado              String    @default("pendiente") @db.VarChar(30)
  boleta_url          String?   @db.VarChar(500)
  comprobante_enviado Boolean   @default(false)
  creado_en           DateTime  @default(now()) @db.Timestamptz(6)
  procesado_en        DateTime? @db.Timestamptz(6)
  usuario             usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([usuario_id])
  @@index([estado])
  @@index([email_solicitante])
}

model wishlist {
  id          Int       @id @default(autoincrement())
  usuario_id  Int?
  producto_id Int?
  creado_en   DateTime? @default(now()) @db.Timestamptz(6)
  producto    producto? @relation(fields: [producto_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuario     usuario?  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([usuario_id, producto_id])
  @@index([usuario_id])
  @@index([producto_id])
}

model email_verification_token {
  id         Int      @id @default(autoincrement())
  usuario_id Int
  token      String   @unique @db.VarChar(255)
  expira_en  DateTime @db.Timestamptz(6)
  creado_en  DateTime @default(now()) @db.Timestamptz(6)
  usuario    usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([token])
  @@index([usuario_id])
}

model password_reset_token {
  id         Int      @id @default(autoincrement())
  usuario_id Int
  token      String   @unique @db.VarChar(255)
  expira_en  DateTime @db.Timestamptz(6)
  usado      Boolean  @default(false)
  creado_en  DateTime @default(now()) @db.Timestamptz(6)
  usuario    usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([token])
  @@index([usuario_id])
}

model refresh_token {
  id         Int      @id @default(autoincrement())
  usuario_id Int
  token      String   @unique @db.VarChar(500)
  expira_en  DateTime @db.Timestamptz(6)
  revocado   Boolean  @default(false)
  creado_en  DateTime @default(now()) @db.Timestamptz(6)
  usuario    usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([token])
  @@index([usuario_id])
  @@index([expira_en])
}
