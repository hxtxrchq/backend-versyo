# ===== BACKEND ENVIRONMENT VARIABLES =====
# Copy this file to .env and fill with your values

# -----------------------------
# Database
# -----------------------------
# Development: postgresql://postgres:password@localhost:5432/versyo_db?schema=public
# Production: Use cloud PostgreSQL (Supabase, Neon, Railway)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# -----------------------------
# JWT
# -----------------------------
JWT_SECRET="your_very_secret_jwt_key_here_min_32_characters"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_EXPIRES_IN="30d"

# -----------------------------
# Cloudinary (Image uploads)
# -----------------------------
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# -----------------------------
# Email (Gmail SMTP)
# -----------------------------
# Generate app password: https://myaccount.google.com/apppasswords
GMAIL_USER="your_email@gmail.com"
GMAIL_APP_PASSWORD="your_16_char_app_password"

# -----------------------------
# Frontend URLs
# -----------------------------
# Development: http://localhost:5173
# Production: https://versyo.chiqo.site
FRONTEND_URL="https://versyo.chiqo.site"
FRONTEND_PEDIDOS_URL="https://versyo.chiqo.site/mis-pedidos"

# -----------------------------
# Server Port
# -----------------------------
PORT=3001

# -----------------------------
# Node Environment
# -----------------------------
NODE_ENV="production"
